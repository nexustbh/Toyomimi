# Copy to .env (gitignored) and fill in. Secrets are read at BUILD time.

# macOS notarization (used by scripts/build-notarized.sh)
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Free TTS — android-tts endpoint key (embedded at build time via build.rs).
# Optional now: users can enter their own key in Settings → TTS → Google TTS — Free, which
# takes priority. If BOTH the user key and this build key are empty, the provider is disabled
# (no hardcoded fallback).
GOOGLE_FREE_TTS_KEY=

# Optional: override the app bundle identifier for `npm run dev` (via scripts/tauri-with-env.mjs).
# Set to a distinct id (e.g. io.github.nexustbh.toyomimi.dev) so the dev build gets its OWN macOS
# Screen-Recording / Microphone permissions, leaving the installed stable app untouched.
# If unset, the default identifier from tauri.conf.json is used.
# APP_IDENTIFIER=io.github.nexustbh.toyomimi.dev

# ── Toyomimi · Phase 0 engine benchmark (scripts/phase0/) ──
# Alibaba Cloud Model Studio (百炼). Region: cn-beijing (国内站) or ap-southeast-1 (国际站/新加坡)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# Soniox (free credits on sign-up)
SONIOX_API_KEY=
