{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toyomimi",
  "version": "0.10.0",
  "identifier": "io.github.nexustbh.toyomimi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Toyomimi",
        "width": 900,
        "height": 500,
        "minWidth": 820,
        "minHeight": 240,
        "center": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc://localhost wss: https:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/*": "scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MEZBNzEwQTBBMTcyMEUKUldRT2NxR2dFS2NQeHVqV0ZMMys0Q2JXVjcwYjUyQ1ZCS1pMM1YwYy80NXBQUHFuMTZRc2dERUwK",
      "endpoints": [
        "https://github.com/nexustbh/Toyomimi/releases/latest/download/latest.json"
      ]
    }
  }
}
